{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smartkey.local/schemas/artifact-provenance.schema.json",
  "title": "SmartKey artifact provenance fields",
  "type": "object",
  "required": ["run_id", "source_hash", "built_at"],
  "properties": {
    "run_id": { "type": "string", "minLength": 20 },
    "source_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "built_at": { "type": "string", "format": "date-time" },
    "tested_at": { "type": "string", "format": "date-time" },
    "packaged_at": { "type": "string", "format": "date-time" },
    "exe_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "build_exe_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "package_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "toolchain": { "type": "object" },
    "environment": { "type": "object" },
    "validation_kind": {
      "enum": ["behavioral", "behavioral_live_vendor", "static_contract"]
    },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "release_status": { "enum": ["signed-release", "unsigned-development", "signature-required"] },
    "signature": { "type": "object" }
  }
}
